// SCRIPT.lark - Complete Grammar for SCRIPT 2.1
// Structural Chemical Representation in Plain Text
// February 2026 - V3 Materials & State Expansion
//
// V3 additions (remaining.md):
//   1. Alloys & Non-Stoichiometry    -> state_attr: "~" FLOAT (Vikalpa)
//   2. Crystallography & Polymorphs  -> macroscopic_context: [[ label ]]
//   3. Extended Polymers (Stochastic)-> polymer_block, polymer_junction
//   4. Electronic & Excited States   -> state_attr: "s:" INT, "*"
//   5. Surface & Interface Chemistry -> phase_boundary: "|"
//
// V4 Lattice Extension (LEAP71 Bridge):
//   L1. Spline bond                ~>          -> bond: SPLINE_BOND
//   L2. Beam radius state attr     <r:float>   -> state_attr: "r:" FLOAT
//   L3. Lattice component tag      [Lattice:T] -> lattice_cell component
//   L4. Thickness class tag        [Thickness:Cls(args)] -> thickness_class
//   L5. Post-process pipe ops      | overoffset(3,0) | intersect  -> post_process
//   L6. Macroscopic namespace      [[geom:..]] / [[xtal:..]]      -> optional prefix
//
// Design notes (V4):
//   * Conformal cell arrays are encoded by the macroscopic_context label
//     (e.g. [[BaseSphere_r50]]). Vertex coords are NOT stored in the
//     string; they are derived by the bridge from the label + cell count.
//     This preserves canonicalization (one design -> one string).
//   * nSubSample (beam thickness resolution) is a render-time parameter
//     in | render(subsample=N), not a topology parameter.
//   * Spline control points: ~> is canonical (PRNG seeded from canonical
//     string hash); ~[p1;p2;...] is explicit escape hatch.
//   * Bounding-voxel queries (BoundaryBeamThickness) are resolved by the
//     bridge from the macroscopic_context label. The IR does not evaluate.


// === Lark Directives ===
%import common.WS
%import common.INT
%import common.FLOAT
%ignore WS


// =============================================================
// TOP LEVEL ENTRY POINT
//
// Every SCRIPT string is parsed as a macroscopic_structure.
// A macroscopic_structure is:
//   - An optional crystallographic / space-group context  [[label]]
//   - Followed by one or more chemical entities (reaction or script)
//   - Entities separated by phase_boundary "|" (surface / interface)
//
// Examples:
//   CC(=O)O                         -> plain script
//   C>>CC                           -> reaction
//   [[Rutile]] Ti(O)2               -> crystallographic context
//   [[Pt_111]] | >C=O              -> surface adsorption
// =============================================================
?start: entry

?entry: macroscopic_structure

macroscopic_structure: macroscopic_context VBAR? (reaction | script) (VBAR (reaction | script))* post_process*
                     | (reaction | script) (VBAR (reaction | script))* post_process*

// V3.2 Crystallography (Sthana) - space group / unit cell label
// Optional lattice parameters: [[Rutile;4.593,4.593,2.959,90,90,90]]
// V4 L6: Optional namespace prefix for disambiguation:
//        [[xtal:Rutile]]  chemistry (explicit)
//        [[geom:BaseSphere_r50]]  geometry/bounding shape (explicit)
//        [[Rutile]]       bare (chemistry, backward compatible)
//        [[BaseSphere_r50]]  bare with Base* prefix (auto-dispatches to geometry)
macroscopic_context: "[[" NAMESPACE? CONTEXT_LABEL (";" lattice_params)? (";" q_vector)? (";" k_vector)? "]]"
NAMESPACE.5: ("geom:" | "xtal:" | "chem:" | "bio:" | "mat:" | "sim:"
            | "astro:" | "env:" | "phys:" | "med:" | "eng:"
            | /[a-z][a-z0-9_]*:/)   // [V4.1] any lowercase namespace + ":"
// [V4.1] CONTEXT_LABEL now allows spaces and a wider char set so
// labels like 'Steel AISI 1045' or 'FE static load 100N' work.
CONTEXT_LABEL: /[A-Za-z0-9_ \-\.]+/

// [V4.3 T2.3] Modulation q-vector for incommensurate / modulated structures
//   [[xtal:P1;q:0.31,0,0]]  — modulation wavevector
// [V4.3 T1.2] Magnetic k-vector for AFM propagation
//   [[mag:Pnma;k:0,0,0.5]]  — AFM propagation vector
q_vector: "q:" signed_num "," signed_num "," signed_num
k_vector: "k:" signed_num "," signed_num "," signed_num

// V3.5 Surface & Interface Chemistry (Adhikarana) - phase separator
VBAR: "|"


// =============================================================
// REACTION GRAMMAR (The Kriya)
// Reactions are one or more scripts separated by ">>" or "=>"
// [V4.3 T2.1] Phase transitions: >>(T=1185K) carries conditions
//   [[xtal:BCC]] Fe >>(T=1185) [[xtal:FCC]] Fe
// We use ( ) not [ ] for conditions to avoid LALR ambiguity with
// bracket_atom (which also starts with [).
// [V4.3] The 2nd+ sides of a reaction can carry their own
// macroscopic_context, enabling phase transitions between different
// crystal structures. The 1st side gets its context from the
// enclosing macroscopic_structure.
// =============================================================
reaction: script (reaction_arrow macroscopic_context? script)+
reaction_arrow: ">>" transition_condition?
              | "=>" transition_condition?
              | "<=>" transition_condition?

// [V4.3 T2.1] Transition condition: temperature, pressure, field, etc.
transition_condition: "(" condition_kv ("," condition_kv)* ")"
condition_kv: IDENTIFIER "=" (FLOAT | INT | IDENTIFIER)


// =============================================================
// SCRIPT - Multi-component Structure
// Components separated by "." (salts/solvates) or "~" (ionic)
// =============================================================
script: component (fragment_separator component)*
fragment_separator: "." | "~"

component: peptide_chain
         | polymer
         | polymer_block
         | molecular_chain
         | ring_closure          // Standalone Anubandha ring (v1.5)
         | lattice_cell          // [V4 L3] Tagged lattice component


// =============================================================
// V4 LATTICE EXTENSION (LEAP71 Bridge)
//
// Lattice components are typed annotations layered on top of an
// existing molecular_chain / polymer. The underlying graph is still
// atoms + bonds; the tags tell a downstream bridge (e.g. PicoGK) how
// to interpret the graph as a beam lattice.
//
// Examples:
//   [Lattice:BodyCentered] {[C]}<n:5-5-5>
//   [Thickness:Constant(2.0)] [Lattice:BodyCentered] {[C]}<n:5-5-5>
//   [[BaseSphere_r50]] [Thickness:Boundary] [Lattice:BodyCentered] {[C]}<n:5-5-5> | intersect
//
// V4.1 GENERALIZED TYPED TAGS:
//   Any [Namespace:Value(args)] now parses via the typed_tag rule.
//   lattice_tag and thickness_tag are special cases for backward compat.
//   Examples:
//     [Mesh:Icosphere(2)]              — meshing strategy
//     [Material:Steel]                 — material assignment
//     [Solver:FEM(order=2)]            — solver configuration
//     [Export:STL(binary)]             — export format
//     [Lattice:BodyCentered]           — V4 L3 (existing)
//     [Thickness:Constant(2.0)]        — V4 L4 (existing)
// =============================================================
lattice_cell: lattice_tag thickness_tag? lattice_subject
            | thickness_tag lattice_tag? lattice_subject
            | lattice_tag typed_tag* lattice_subject        // [V4.1] Lattice + general tags
            | typed_tag+ lattice_subject                    // [V4.1] general tags only

lattice_subject: molecular_chain
               | polymer
               | polymer_block
               | peptide_chain

// [V4 L3] Lattice tag — recognized by literal "Lattice:" prefix so it
// doesn't get captured by the general typed_tag rule. The TAG_VALUE
// regex would otherwise match "Lattice" as a namespace.
lattice_tag: "[" "Lattice:" LATTICE_TYPE "]"
LATTICE_TYPE: ("BodyCentered" | "Octahedron" | "RandomSpline" | "Custom" | /[A-Z][A-Za-z0-9_]*/)

thickness_tag: "[" "Thickness:" THICKNESS_CLASS ("(" thickness_args ")")? "]"
THICKNESS_CLASS: ("Constant" | "CellBased" | "GlobalFunc" | "Boundary" | /[A-Z][A-Za-z0-9_]*/)
thickness_args: thickness_arg ("," thickness_arg)*
thickness_arg: FLOAT | INT | IDENTIFIER
IDENTIFIER: /[a-zA-Z_][a-zA-Z0-9_]*/

// [V4.1] Generalized typed tag: [Namespace:Value(args)]
//   TAG_NAMESPACE: PascalCase identifier followed by ":"
//   Must be >= 3 chars and contain at least one lowercase letter
//   (to avoid matching element symbols like "O4", "S2", "Fe", "He").
//   The (?=:) lookahead ensures we're inside a tag context.
//   Negative lookahead excludes Lattice and Thickness (dedicated rules).
typed_tag: "[" TAG_NAMESPACE ":" (TAG_VALUE | STRING) ("(" tag_args? ")")? "]"
TAG_NAMESPACE: /(?!Lattice|Thickness)[A-Z][A-Za-z0-9_]*[a-z_][A-Za-z0-9_]*(?=:)/
TAG_VALUE: /[A-Z][A-Za-z0-9_\-]*/
tag_args: tag_arg (("," | ";") tag_arg)*    // [V4.3] ; for stacking disorder [Stack:ABC;ABA]
tag_arg: tag_kv | signed_num | IDENTIFIER | STRING
tag_kv: IDENTIFIER "=" (signed_num | IDENTIFIER | STRING)

// [V4.3] STRING literal for tag args that need special chars (-, (), etc.)
//   [KPath:"Gamma(0,0,0)-X(0.5,0,0)"]  — explicit k-point coords
//   [Path:"NEB(0,0,0)-(0.5,0.5,0.5)"]  — NEB diffusion path
STRING: "\"" /[^"]*/ "\""


// =============================================================
// V4 L5: POST-PROCESS PIPELINE
//
// Pipe-forward style post-processing operators applied to the
// voxelized result. These are RENDER-time ops, not topology — they
// do not affect canonicalization of the underlying graph.
//
// We use |>(pipe-forward, Elixir/F# style) rather than bare | because
// | is already taken by VBAR (phase boundary). LALR(1) cannot
// disambiguate "| overoffset(3,0)" (post-process) from "| CCO" (phase
// boundary to a new molecule) without backtracking.
//
// Syntax:  |> op_name(arg, arg, ...)   |> op_name   (no args)
// Examples:
//   |> overoffset(3,0)    // Sh.voxOverOffset(voxLattice, 3, 0)
//   |> intersect          // Sh.voxIntersect(voxLattice, voxBounding)
//   |> smoothen           // Sh.voxSmoothen(voxLattice)
//   |> offset(1)          // Sh.voxOffset(voxLattice, 1)
//   |> render(subsample=5)  // sets nSubSample for beam thickness queries
// =============================================================
post_process: PIPE_FWD PIPE_OP ("(" pipe_args? ")")?
PIPE_FWD: "|>"
// [V4.1] PIPE_OP now accepts any lowercase identifier — the known ops
// (smoothen, overoffset, intersect, offset, render) are listed first
// for documentation; the regex fallback lets any op name parse so the
// grammar can express arbitrary pipelines (subdivide, bevel, export,
// morgan, gaussian, etc.) without grammar changes.
PIPE_OP: ("smoothen" | "overoffset" | "intersect" | "offset" | "render"
         | "subdivide" | "bevel" | "smooth" | "cap" | "export"
         | "mesh" | "remesh" | "decimate" | "boolean"
         | /[a-z][a-z0-9_]*/)
pipe_args: pipe_arg ("," pipe_arg)*
pipe_arg: pipe_kv | FLOAT | INT | IDENTIFIER
pipe_kv: IDENTIFIER "=" (FLOAT | INT | IDENTIFIER)


// =============================================================
// MOLECULAR CHAIN
// A molecular chain starts with an optional bond (for organometallics
// like >C=O adsorbed on surfaces, or haptic *5 in ferrocene).
// Then: atom_expr followed by (bond? atom_or_ring_or_branch)*
// =============================================================
molecular_chain: maybe_periodic_bond? atom_expr (maybe_periodic_bond? (atom_expr | local_ring | branch))*

atom_expr: (ORGANIC_ATOM | bracket_atom | dhatu | WILDCARD) multiplier?
multiplier: INT


// =============================================================
// DHATU (The V2 Atom Notation with State Block)
// Dhātu = Sanskrit "root" - the irreducible atomic specification.
// Example: C<13,+>@  (Carbon-13, cation, chiral)
//          Ti<~0.9>  (Titanium with fractional alloy occupancy)
//          O<s:3>    (Triplet oxygen)
// =============================================================
dhatu: ATOM [state_block] chiral?

state_block: "<" state_attr ("," state_attr)* ">"

// !state_attr keeps tree nodes for every alternative (needed by parser)
!state_attr: INT            // Mass / Isotope:            <13>
           | CHARGE_ATTR    // Formal Charge:             <+>, <2->
           | GEOMETRY       // Coordination geometry:     <sqp>, <oct>
           | H_COUNT_ATTR   // Explicit H count:          <h3>
           | "m"            // Tautomer / Mobility flag:  <m>
           | "~" FLOAT      // Vikalpa - Alloy occupancy: <~0.9>          [V3.1]
           | "~" FLOAT "-" FLOAT  // [V4.3 T1.5] Composition range: <~0.5-0.7>
           | "s:" INT       // Svara - Spin multiplicity: <s:3>          [V3.4]
           | "*"            // Excited state marker:       <*>            [V3.4]
           | "r:" (FLOAT | INT)   // Beam radius ratio:    <r:0.5>, <r:2>  [V4 L2]
           | SPIN_UP        // [V4.3 T1.2] Magnetic spin up:    <↑>
           | SPIN_DOWN      // [V4.3 T1.2] Magnetic spin down:  <↓>
           | SPIN_PAIRED    // [V4.3 T1.2] Spin paired (no net): <↑↓>
           | "m:" signed_num "," signed_num "," signed_num  // [V4.3 T1.2] Magnetic moment vector <m:0,0,2.2>
           | "occ:" FLOAT   // [V4.3 T1.1] Explicit site occupancy (for defects) <occ:0.5>
           | "pos:" pos_alt (";" pos_alt)*  // [V4.3 T2.4] Positional disorder (split sites)
           | "od" INT        // [V4.3 T2.4] Orientational disorder <od4> (n-fold)
           | "sd" IDENTIFIER // [V4.3 T2.4] Stacking disorder <sdABC>

// [V4.3 T2.4] Positional disorder: alternative positions separated by ;
//   <pos:0.5,0.5,0.5;0.5,0.5,0.6>  — two alternative sites
pos_alt: signed_num "," signed_num "," signed_num

SPIN_UP: "\u2191"        // ↑
SPIN_DOWN: "\u2193"      // ↓
SPIN_PAIRED: "\u2191\u2193"  // ↑↓ (must precede SPIN_UP for longest match)


// =============================================================
// ORGANIC ATOMS (UPPERCASE ONLY - Kekule / Anubandha System)
// Lowercase atoms removed. Aromaticity handled topologically.
// =============================================================
ORGANIC_ATOM: "Br" | "Cl" | "At" | "Ts"
            | "Ph"
            | "B" | "C" | "N" | "O" | "P" | "S" | "F" | "I"

WILDCARD: "*"


// =============================================================
// BRACKET ATOM - Full periodic table, explicit specification
// Supports: [13C@H-:1]  (isotope, chiral, H, charge, mapping)
//           [O.]         (radical)
//           [Fe]         (transition metal)
// [V4.3 T1.1] Defect atoms: [_:Fe] vacancy, [I:C] interstitial
// =============================================================
bracket_atom: "[" isotope? element chiral? hcount? charge? radical? ring_class? state_block? "]"
            | "[" "*" "]"           // Wildcard atom [*] — scaffold attachment, query atom
            | "[" query_atom "]"    // Query atom — SMARTS-style substructure patterns
            | "[" defect_type ":" element? state_block? "]"   // [V4.3 T1.1] Defect atom

// [V4.3 T1.1] Defect types for materials science
//   [_:Fe]   — vacancy at Fe site (empty lattice position)
//   [Df:C]   — interstitial C (Df = DeFect interstitial marker)
//   [V:Cl]<->— F-center (Cl vacancy with trapped electron)
// NOTE: "Df" for interstitial avoids collision with indium (In) and
// iodine (I). The lookahead (?=:) ensures "Df" only matches as a defect
// marker when followed by ":", so it doesn't conflict with other uses.
defect_type: DEFECT_VACANCY | DEFECT_INTERSTITIAL
DEFECT_VACANCY: "_" | "V"       // _ or V (must not conflict with Vanadium)
DEFECT_INTERSTITIAL: /Df(?=:)/  // [V4.3] DeFect interstitial, requires ":"

// Query atoms (Praśna — the question/pattern)
// These are pattern atoms for substructure search, not canonical representations.
// They are read-only: SCRIPTFromMol never emits them; SCRIPTParser reads them.
//
//   [#6]      atomic number query (carbon)
//   [!N]      negation (not nitrogen)
//   [R]       any ring atom
//   [r5]      atom in 5-membered ring
//   [vN]      valence = N
//   [R] [!R]  ring / non-ring
//   [#6,#7]   OR query (carbon or nitrogen)
//
// [V4.3] Recursive SMARTS: [?(PATTERN)] — atom must satisfy PATTERN
//   [?(C(=O)O)]            — atom that is part of a carboxylic acid
//   [!?(N=O)]              — atom NOT part of a nitro group
//   [C;?(C:C:C:C:C:C&6:)]  — carbon AND in aromatic 6-ring
//
// The ?(...) contains a SCRIPT molecular_chain matched as a substructure
// starting from this atom. This is the SMARTS \$(...) equivalent.
query_atom: query_primitive ("," query_primitive)*   // OR of primitives
          | query_primitive (";" query_primitive)*   // AND of primitives

RECURSIVE_QUERY: "?(" /(?:[^()]|\([^()]*\))*/ ")"    // [V4.3] ?(PATTERN) — allows 1 level of nested ()

query_primitive: "!" query_primitive                         // negation
               | "#" INT                                     // atomic number
               | "R" INT?                                    // ring membership (optional ring size)
               | "r" INT?                                    // ring size
               | "v" INT                                     // valence
               | "X" INT                                     // connectivity (total degree)
               | "q" INT?                                    // total charge query
               | "a"                                         // aromatic
               | "A"                                         // aliphatic
               | QUERY_ELEM                                  // element symbol in query context
               | RECURSIVE_QUERY                             // [V4.3] recursive SMARTS

// [V4.3] Recursive pattern content (captured as raw string for matching)
// The bridge interprets this as a SCRIPT substructure to match.

// Element symbols allowed inside query atoms
// (separate terminal to avoid reduce/reduce collision with 'element' rule)
QUERY_ELEM: "He"|"Li"|"Be"|"Ne"|"Na"|"Mg"|"Al"|"Si"|"Cl"|"Ar"|"Ca"|"Sc"|"Ti"|"Cr"
          | "Mn"|"Fe"|"Co"|"Ni"|"Cu"|"Zn"|"Ga"|"Ge"|"As"|"Se"|"Br"|"Kr"|"Rb"
          | "Sr"|"Zr"|"Nb"|"Mo"|"Tc"|"Ru"|"Rh"|"Pd"|"Ag"|"Cd"|"In"|"Sn"|"Sb"
          | "Te"|"Xe"|"Cs"|"Ba"|"Pt"|"Au"|"Hg"|"Pb"|"Bi"|"Rn"
          | "B"|"C"|"N"|"O"|"F"|"P"|"S"|"I"|"K"|"V"|"W"|"Y"|"U"|"H"

// Full Periodic Table — all 118 elements.
// Uses the ATOM terminal (defined below) so that Lark's lexer applies
// consistent longest-match priority across all element-matching contexts
// (bracket_atom, dhatu, query_atom).  Previously, the element rule used
// inline string literals which competed with ATOM and QUERY_ELEM for
// lexer priority, causing "Ir" to lex as "I" + "r".
element: ATOM

// Isotope (mass number before element symbol)
isotope: INT

// Complete Stereochemistry Support (Anchored to DFS Vak Order)
chiral: "@@"        // Tetrahedral S   (must precede "@" for longest match)
      | "@R"        // Sthiti: CIP-absolute R (frame-independent)
      | "@S"        // Sthiti: CIP-absolute S (frame-independent)
      | "@r"        // Yatha-samkhya: pseudoasymmetric r (secondary)
      | "@s"        // Yatha-samkhya: pseudoasymmetric s (secondary)
      | "@PL1"      // Sthana: planar chirality variant 1
      | "@PL2"      // Sthana: planar chirality variant 2
      | "@SP1"      // Square planar — cis
      | "@SP2"      // Square planar — trans
      | "@SP"       // Square planar (unspecified geometry)
      | "@OH1"      // Octahedral — fac (Δ)
      | "@OH2"      // Octahedral — fac (Λ)
      | "@OH3"      // Octahedral — mer variant 1
      | "@OH4"      // Octahedral — mer variant 2
      | "@OH5"      // Octahedral — mer variant 3
      | "@OH"       // Octahedral (unspecified geometry)
      | "@AX1"      // Allene / atropisomer CW   (geometry-resolved)
      | "@AX2"      // Allene / atropisomer CCW  (geometry-resolved)
      | "@AX"       // Axial / atropisomer (unresolved, no 3D coords)
      | "@TB1"      // Trigonal bipyramidal — apical substitution A
      | "@TB2"      // Trigonal bipyramidal — apical substitution B
      | "@TB"       // Trigonal bipyramidal (unspecified)
      | "@PY1"      // Pyramidal — CW
      | "@PY2"      // Pyramidal — CCW
      | "@PY"       // Pyramidal (unspecified)
      | "@"         // Tetrahedral R

// Hydrogen count inside brackets
hcount: "H" INT?

// Formal charge inside brackets
charge: "++" | "--"
      | "+" INT?
      | "-" INT?

// Radical marker inside bracket atoms
// [O.]=monovalent radical,  [C..]=divalent diradical
radical: ".." | "."

// Ring class = atom mapping number for reaction tracking
ring_class: ":" INT


// =============================================================
// CHEMICAL BONDS (The State Markers / Sandhi)
//
// bond carries an optional INT for hapticity (e.g., *5 = eta-5)
// This unifies the old bond + bond_explicit into one rule,
// eliminating all Reduce/Reduce LALR collisions.
// =============================================================
bond: DATIVE             // Dative:         ->
    | REV_DATIVE         // Reverse dative: <-
    | SINGLE_BOND        // Single:          -
    | DOUBLE_BOND        // Double:          =
    | TRIPLE_BOND        // Triple:          #
    | AROMATIC_BOND      // Aromatic:        :
    | EXPLICIT_MOBILE    // Tautomeric:     =: or ~:
    | UP_BOND            // Stereo up:       /
    | DOWN_BOND          // Stereo down:     \
    | COORDINATE_BOND    // Coordinate:      >
    | hbond              // Haptic: *INT  or bare * (resonance)
    | SPLINE_BOND        // Spline beam:    ~>            [V4 L1]
    | spline_explicit    // Spline w/ explicit control points: ~[x,y,z;...]  [V4.2 Q5]
    | BRIDGE_BOND        // 3-center-2-electron: <>  [V4.3] (diborane, carboranes)

// [V4.2 Q5] Explicit spline control points: ~{x1,y1,z1;x2,y2,z2;...}
// Each point is a 3D coordinate. Use ; to separate points.
// Example: C~{0.0,0.0,0.0;1.0,1.0,1.0;2.0,0.0,0.0}C
//
// NOTE: We use ~{ ... } instead of ~[ ... ] to avoid LALR ambiguity with
// fragment_separator ~ followed by bracket_atom [Cl-]. The { char is only
// used for peptide_chain/polymer, so ~{ is unambiguous as a spline start.
spline_explicit: "~{" ctrl_point (";" ctrl_point)* "}"
ctrl_point: signed_num "," signed_num "," signed_num

// hbond: STAR_BOND INT = haptic eta-n bond (explicit hapticity number required).
// NOTE (fix): previously `hbond: STAR_BOND INT?` also allowed a bare STAR_BOND
// with no following INT. Because STAR_BOND and WILDCARD both lex the literal
// "*", a bare "*" was simultaneously a valid reduction as `hbond` (bare
// resonant bond) and as `atom_expr` (wildcard atom) at the same grammar
// position, causing the lexer to silently and unconditionally prefer
// STAR_BOND — so a standalone wildcard atom `*` could never parse, even
// though atom_expr explicitly allows WILDCARD. Requiring the hapticity INT
// removes the ambiguous bare-STAR_BOND production; haptic bonds without an
// explicit eta-n number had no well-defined chemical meaning regardless.
hbond: STAR_BOND INT

DATIVE: "->"
REV_DATIVE: "<-"
SINGLE_BOND: "-"
DOUBLE_BOND: "="
TRIPLE_BOND: "#"
AROMATIC_BOND: ":"
EXPLICIT_MOBILE: "~:" | "=:"
UP_BOND: "/"
DOWN_BOND: "\\"
COORDINATE_BOND: ">"
STAR_BOND: "*"
SPLINE_BOND: "~>"   // [V4 L1] Spline beam — must precede EXPLICIT_MOBILE's ~:
BRIDGE_BOND: "<>"   // [V4.3] 3-center-2-electron bridge (diborane, carboranes)



// =============================================================
// BRANCHES
// Bond-first branches like (=O) specify how branch connects
// to the parent chain. The leading bond is now part of
// molecular_chain itself, so branch_content is clean.
// =============================================================
branch: "(" branch_content ")" multiplier?

branch_content: peptide_chain
              | molecular_chain


// =============================================================
// V2 RING CLOSURE (The Anubandha System)
// &6: = 6-membered aromatic ring
// &6. = 6-membered aliphatic ring
// Legacy: bare digit (1-9 atoms back) or %NN
// =============================================================
local_ring: ring_closure
          | DIGIT              // Legacy: 1-9 atoms back
          | "%" DIGIT DIGIT    // Legacy: 10-99 atoms back
          | named_ring         // Legacy: [A], [B] polycycles

ring_closure: "&" INT anubandha?
anubandha: ":"   // Resonant / Aromatic  — &6: = 6-membered aromatic
         | "-"   // Aliphatic / Standard — &6- = 6-membered aliphatic (was &6.)
                 // '-' matches the existing SINGLE_BOND token semantic,
                 // removing the previous collision where '.' served both as
                 // ring bond marker and fragment separator.

named_ring: "[" LETTER "]"


// =============================================================
// PEPTIDE CHAINS {A.G.S.C[A]K}
// Bridges can appear inline between monomers (C[A]K)
// or after the full sequence {A.G.S[A][B]}
// =============================================================
peptide_chain: "{" peptide_body "}" local_ring?

// Peptide body: dot-separated monomer_elements + optional trailing bridges
peptide_body: monomer_element ("." monomer_element)* bridge*

// A monomer with optional trailing bridges
monomer_element: monomer (bridge monomer)* bridge*

// 20 Standard Amino Acids (single-letter AND 3-letter codes)
AMINO_ACID: "Ala" | "Arg" | "Asn" | "Asp" | "Cys" | "Glu" | "Gln" | "Gly"
          | "His" | "Ile" | "Leu" | "Lys" | "Met" | "Phe" | "Pro" | "Ser"
          | "Thr" | "Trp" | "Tyr" | "Val"
          | "A" | "R" | "N" | "D" | "C" | "E" | "Q" | "G" | "H" | "I"
          | "L" | "K" | "M" | "F" | "P" | "S" | "T" | "W" | "Y" | "V"

monomer: AMINO_ACID
       | PTM_CODE
       | NUCLEOTIDE
       | NUC_MOD_CODE

// Standard nucleotide bases (DNA and RNA)
// Single-letter codes: A, G, C, T (DNA), U (RNA), and 3-letter codes
NUCLEOTIDE: "dA" | "dG" | "dC" | "dT"    // DNA (deoxy)
          | "rA" | "rG" | "rC" | "rU"    // RNA
          | "A" | "G" | "C" | "T" | "U"  // ambiguous (context-determined)

// Nucleotide modification codes (epigenetics, therapeutics, probes)
// Naming convention: modification-prefix + base (e.g. m5C = 5-methyl-cytosine)
NUC_MOD_CODE: "m5C"   // 5-methylcytosine (DNA methylation)
            | "m6A"   // N6-methyladenine
            | "hm5C"  // 5-hydroxymethylcytosine
            | "f5C"   // 5-formylcytosine
            | "ca5C"  // 5-carboxylcytosine
            | "m1A"   // 1-methyladenine (RNA)
            | "m1G"   // 1-methylguanosine (RNA)
            | "m2G"   // N2-methylguanosine
            | "m22G"  // N2,N2-dimethylguanosine
            | "m7G"   // 7-methylguanosine (RNA cap)
            | "psU"   // pseudouridine
            | "s4U"   // 4-thiouridine
            | "I"     // inosine
            | "diU"   // dihydrouridine

// Post-Translational Modifications (50+ common PTMs)
PTM_CODE: "nitY" | "acK" | "ubK" | "suK" | "oxM" | "Hyp" | "Hyl"
        | "Orn" | "Cit" | "Sec" | "Pyl" | "Gla" | "Dpr" | "Dab" | "Sar"
        | "pS" | "pT" | "pY" | "mK" | "mR"

// Bridge notation in peptide context (disambiguated from named_ring)
bridge: "[" LETTER "]"


// =============================================================
// V3.3 EXTENDED POLYMERS (Abhyasa - Stochastic Copolymers)
//
// Simple repeating unit:
//   {[CCCO]}n                         simple repeat
//   {[CCCO]}<n:50>                    exact length
//   {[CCCO]}<n:50-100>                stochastic range
//
// Block copolymer (polymer_block at component level):
//   {[CCCO]}<n:50> -b- {[c1ccccc1CC]}<n:100>
//
// polymer_block is a standalone component so that multi-block
// sequences parse without inline LALR ambiguity.
// =============================================================
polymer: "{[" polymer_unit "]}" polymer_suffix?

polymer_unit: molecular_chain | peptide_chain

// A block copolymer: two or more polymer units joined by a junction keyword
// Examples:
//   {[CC]}<n:50> -b- {[CCCO]}<n:100>
//   {[CC]}<n:50> -alt- {[N]}<n:50>
polymer_block: polymer polymer_junction polymer (polymer_junction polymer)*

// Suffix: repeat count or block junction (for inline multi-block inside a single polymer)
polymer_suffix: polymer_multiplier
              | repeat_spec

polymer_multiplier: "<n:" INT ">"
                  | "<n:" INT "-" INT ">"

// Block junctions - full set including IUPAC aliases
// -b-   diblock
// -alt- alternating  (alias: -a-)
// -ran- random       (alias: -r-, -stat-)
// -g-   graft
polymer_junction: "-b-"
                | "-alt-" | "-a-"
                | "-ran-" | "-r-" | "-stat-"
                | "-g-"

// Repeat spec for simple polymers: {[unit]}n, {[unit]}50, {[unit]}0_7
repeat_spec: "n"
           | RATIO
           | INT

RATIO: INT "_" INT


// =============================================================
// V3.6 PERIODIC TOPOLOGY (LQG / Crystal / MOF support)
//
// Periodic bonds encode cross-unit-cell connectivity using an
// integer lattice translation vector (tx, ty, tz).
// Based on the Labeled Quotient Graph (LQG) formalism.
//
// Syntax:  bond @tx,ty,tz
// Examples:
//   Ti->@0,0,1O    dative bond with +c translation (MOF pillar)
//   Fe-@1,0,0Fe   single bond crossing +a unit cell boundary
//   C-@0,0,0C     intracell bond (same as plain C-C)
//
// maybe_periodic_bond: a bond optionally followed by a translation vector.
// This single rule avoids LALR(1) conflicts that arise from (bond | periodic_bond).
// The @ character after a bond token is unambiguous because @ only appears
// inside bracket atoms in all other grammar contexts.
//
// Lattice parameters encoded in macroscopic_context:
//   [[Rutile;4.593,4.593,2.959,90,90,90]]
//    = label + a(Å), b(Å), c(Å), α(°), β(°), γ(°)
// =============================================================
maybe_periodic_bond: bond ("@" signed_num "," signed_num "," signed_num)?

// [V4.2 Q2] signed_num accepts INT or FLOAT, so crystallographic fractional
// translations like @0.5,0.5,0.5 work alongside integer @1,0,0.
signed_int: "-" INT  -> neg_int
          | INT      -> pos_int

// [V4.2 Q2] signed_num: int or float, with optional sign
signed_num: "-" num  -> neg_num
          | num      -> pos_num

num: FLOAT | INT

// Lattice parameters: a, b, c in Angstroms; alpha, beta, gamma in degrees
lattice_params: lattice_val "," lattice_val "," lattice_val "," lattice_val "," lattice_val "," lattice_val
lattice_val: FLOAT | INT
DIGIT: "0".."9"
LETTER: "A".."Z"

// ATOM terminal used by dhatu (V2 atom notation)
// ATOM terminal — all 118 elements.  Two-letter symbols must come BEFORE
// single-letter ones in the alternation so that Lark's lexer (longest-match
// priority) picks e.g. "Ir" instead of "I" + "r".  Many transition metals
// (Ir, Hf, Ta, Re, Os, Tc, Ru, Rh, Nb, Mo, ...) and lanthanides/actinides
// were previously missing, causing "[Ir@SP]" to lex as "I" (iodine) + "r".
ATOM: "He"|"Li"|"Be"|"Ne"|"Na"|"Mg"|"Al"|"Si"|"Cl"|"Ar"|"Ca"|"Sc"|"Ti"|"Cr"|"Mn"|"Fe"|"Co"|"Ni"|"Cu"|"Zn"|"Ga"|"Ge"|"As"|"Se"|"Br"|"Kr"|"Rb"|"Sr"|"Zr"|"Nb"|"Mo"|"Tc"|"Ru"|"Rh"|"Pd"|"Ag"|"Cd"|"In"|"Sn"|"Sb"|"Te"|"Xe"|"Cs"|"Ba"|"La"|"Ce"|"Pr"|"Nd"|"Pm"|"Sm"|"Eu"|"Gd"|"Tb"|"Dy"|"Ho"|"Er"|"Tm"|"Yb"|"Lu"|"Hf"|"Ta"|"Re"|"Os"|"Ir"|"Pt"|"Au"|"Hg"|"Tl"|"Pb"|"Bi"|"Po"|"At"|"Rn"|"Fr"|"Ra"|"Ac"|"Th"|"Pa"|"Np"|"Pu"|"Am"|"Cm"|"Bk"|"Cf"|"Es"|"Fm"|"Md"|"No"|"Lr"|"Rf"|"Db"|"Sg"|"Bh"|"Hs"|"Mt"|"Ds"|"Rg"|"Cn"|"Nh"|"Fl"|"Mc"|"Lv"|"Ts"|"Og"
    | "C"|"N"|"O"|"F"|"P"|"S"|"K"|"V"|"I"|"W"|"U"|"Y"|"H"|"B"

// Charge attribute terminal
CHARGE_ATTR: "++" | "--" | "+" | "-" | /[0-9]+[+-]/ | /[+-][0-9]+/
CHARGE: CHARGE_ATTR         // v1.5 alias

// Coordination geometry
GEOMETRY: "sqp" | "oct" | "tet" | "tbp"

// Hydrogen count attribute
H_COUNT_ATTR: "h" INT
